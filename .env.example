# Optional overrides. Copy to `.env` and adjust if needed — most setups don't need this file
# at all, since the primary config lives in `pendo-automation.config.json` (see README).

# Path to the automation config file, used instead of the default
# `./pendo-automation.config.json` lookup. Rarely needed — prefer `--config <path>`
# on the CLI, or just placing pendo-automation.config.json in the project root.
# PENDO_AUTOMATION_CONFIG=./pendo-automation.config.json
